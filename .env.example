# Скопіюйте цей файл у .env і впишіть свої ключі.
# Жоден з цих ключів не повинен потрапити у фронтенд-код чи в git.

OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Google часто вимикає старі моделі Gemini — якщо ChatGPT/Gemini раптом
# почнуть падати з HTTP 404, перевірте актуальну назву на ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash

# "Зона невидимості": скільки нішевих запитів ставити (1-3) і яким системам.
# Більше запитів/систем = точніша картина, але й більше платних викликів API.
DISCOVERY_QUERY_COUNT=3
DISCOVERY_ENGINES=chatgpt,gemini,perplexity,claude

# Необов'язково: URL, куди додатково відправляється кожен лід
# (Make/Zapier/Google Apps Script/Telegram-бот через посередника і т.д.)
LEAD_WEBHOOK_URL=

# Пошта для PDF-звіту (resend.com — безкоштовний акаунт, простий API).
# RESEND_FROM_EMAIL має бути з підтвердженого у Resend домену, або
# лишіть тестову onboarding@resend.dev для швидкого старту.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AI-Visibility <onboarding@resend.dev>

PORT=8787
